{
	"name": "beam-statics",
	"version": "0.1.0",
	"description": "Compute and draw beam reactions, shear force, bending moment and deflection diagrams from a text block in your notes.",
	"main": "main.js",
	"type": "module",
	"private": true,
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"typecheck": "tsc -noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"coverage": "vitest run --coverage",
		"lint": "eslint .",
		"preview": "node scripts/preview/build.mjs",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"keywords": [
		"obsidian",
		"beam",
		"statics",
		"structural-engineering",
		"shear-force",
		"bending-moment"
	],
	"author": "lucasmcazelli",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/lucasmcazelli/obsidian-beam-static-diagram.git"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.4",
		"@types/node": "^26.6.6",
		"@vitest/coverage-v8": "^5.0.5",
		"esbuild": "0.28.2",
		"eslint": "^9.39.4",
		"eslint-plugin-obsidianmd": "^0.4.2",
		"globals": "^17.6.0",
		"happy-dom": "21.0.4",
		"jiti": "^2.6.1",
		"obsidian": "1.14.4",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.72.1",
		"vitest": "^5.0.3"
	},
	"engines": {
		"node": ">=22.12.0"
	}
}
